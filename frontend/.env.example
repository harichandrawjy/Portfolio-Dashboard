# Copy to frontend/.env and adjust. Never commit frontend/.env.

# One-click demo sign-in on the login page.
#
# Set BOTH to show an "Explore the demo portfolio" button; leave either unset
# and the button is not rendered at all. These are baked into the client
# bundle at build time, so only ever use a throwaway account — the one
# `python -m app.seed_demo` creates is exactly that.
VITE_DEMO_EMAIL=demo@arus.id
VITE_DEMO_PASSWORD=arus-demo-123
