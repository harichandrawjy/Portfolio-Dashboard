# Copy to .env and adjust values. Never commit .env.

# Postgres — docker-compose reads these (safe defaults exist for local dev)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=portfolio

# Backend — SQLAlchemy async URL.
# Inside docker-compose the backend gets this injected with host `db`;
# this value is for running the backend directly on your machine.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/portfolio

# JWT signing key. Generate a real one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
