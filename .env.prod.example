# Copy to .env.prod on the server and fill in. NEVER commit the real file.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every value here is required: docker-compose.prod.yml uses `${VAR:?...}`, so
# a missing one stops the deploy with a readable error instead of quietly
# falling back to the development defaults in docker-compose.yml.

# The JWT signing key. Anyone who knows it can mint a token for any account,
# so generate a fresh one and do not reuse the dev value:
#   openssl rand -hex 32
SECRET_KEY=

# Postgres. The database is only reachable from the compose network and
# 127.0.0.1, but use a real password anyway — a future `docker compose` on a
# shared box, or a mistaken port publish, should not hand over the data.
POSTGRES_USER=arus
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# The hostname Caddy requests a certificate for. Must already point at this
# server's IP or the ACME challenge fails.
#   real domain -> arus.example.com
#   no domain yet, IP only -> :80   (plain HTTP, no certificate)
DOMAIN=

# --- outbound email (REQUIRED) ---------------------------------------------
# Signing in requires a confirmed address, so without these the backend
# refuses to start: every new account would be created unusable and every
# forgotten password unrecoverable. Compose names whichever one is missing.
#
# SMTP_PASSWORD is a Google APP PASSWORD, not the account password. Generate
# one at https://myaccount.google.com/apppasswords (the account needs 2FA on
# first). Gmail rejects plain account passwords for SMTP, and an app password
# can be revoked on its own.
#
# Port 25 is blocked outbound on Oracle Cloud; 587 is open and is what this
# uses. Deliverability note: a DuckDNS subdomain cannot publish SPF/DKIM, so
# mail goes out as your Gmail address signed by Google rather than by the
# site's own domain. Test to a non-Gmail recipient before relying on it.
SMTP_USER=
SMTP_PASSWORD=
# Both optional — shown as the defaults that apply if left unset.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#MAIL_FROM_NAME=Arus

# Origin used to build the links inside those emails. Defaults to
# https://$DOMAIN, which is right whenever DOMAIN is a real hostname. Set it
# explicitly only for an IP-only box, where DOMAIN is ":80" and the derived
# default would be the nonsense "https://:80" (the backend rejects that at
# boot rather than sending links nobody can follow).
#APP_BASE_URL=http://203.0.113.10

# --- demo sign-in ----------------------------------------------------------
# `POST /auth/demo` hands each visitor a private, throwaway clone of the demo
# portfolio — no shared account, no credentials in the JS bundle, nothing to
# keep in step with the backend. Run `python -m app.seed_demo` once to create
# the template that gets cloned.
#
# The endpoint is rate-limited per caller and its accounts are purged nightly.
# Set this to false on a private deployment to switch it off entirely; the
# login page hides the button when the endpoint answers 404.
DEMO_ENABLED=true
