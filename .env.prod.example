# Copy to .env.prod on the server and fill in. NEVER commit the real file.
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Every value here is required: docker-compose.prod.yml uses `${VAR:?...}`, so
# a missing one stops the deploy with a readable error instead of quietly
# falling back to the development defaults in docker-compose.yml.

# The JWT signing key. Anyone who knows it can mint a token for any account,
# so generate a fresh one and do not reuse the dev value:
#   openssl rand -hex 32
SECRET_KEY=

# Postgres. The database is only reachable from the compose network and
# 127.0.0.1, but use a real password anyway — a future `docker compose` on a
# shared box, or a mistaken port publish, should not hand over the data.
POSTGRES_USER=arus
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# The hostname Caddy requests a certificate for. Must already point at this
# server's IP or the ACME challenge fails.
#   real domain -> arus.example.com
#   no domain yet, IP only -> :80   (plain HTTP, no certificate)
DOMAIN=

# --- frontend build-time values (NOT read by the containers) ---------------
# These are baked into the JS bundle by `npm run build`, so they are public by
# construction — anyone can read them in devtools. That is why the demo login
# must be a throwaway account with nothing private in it. Leave both unset to
# ship without the demo button at all.
#
# These are NOT free-form. `app/seed_demo.py` hardcodes the account it creates,
# so anything else here builds a demo button that fails to log in — and because
# Vite inlines them at BUILD time, correcting it needs `up -d --build`, not a
# restart. The values below are the ones seed_demo actually creates.
VITE_DEMO_EMAIL=demo@arus.id
VITE_DEMO_PASSWORD=arus-demo-123
